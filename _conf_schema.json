{
  "api_key": {
    "description": "MiniMax API Key 列表",
    "type": "list",
    "default": [],
    "hint": "以 sk- 开头。添加多个 Key 可实现额度池化，插件自动按模型额度轮询。"
  },
  "region": {
    "description": "API 区域",
    "type": "string",
    "options": ["cn", "global"],
    "default": "cn"
  },
  "base_url": {
    "description": "自定义 API 地址（留空则使用区域默认地址）",
    "type": "string",
    "default": ""
  },
  "timeout": {
    "description": "请求超时（秒）",
    "type": "int",
    "default": 300
  },
  "video_poll_interval": {
    "description": "视频生成轮询间隔（秒）",
    "type": "int",
    "default": 5
  },
  "video_timeout": {
    "description": "视频生成超时（秒）",
    "type": "int",
    "default": 600
  },
  "default_image_model": {
    "description": "默认图片生成模型",
    "type": "string",
    "default": "image-01"
  },
  "default_video_model": {
    "description": "默认视频生成模型",
    "type": "string",
    "default": "MiniMax-Hailuo-2.3"
  },
  "default_video_sef_model": {
    "description": "默认首尾帧视频模型",
    "type": "string",
    "default": "MiniMax-Hailuo-02"
  },
  "default_video_subject_model": {
    "description": "默认角色一致性视频模型",
    "type": "string",
    "default": "S2V-01"
  },
  "default_speech_model": {
    "description": "默认语音合成模型",
    "type": "string",
    "default": "speech-2.8-hd"
  },
  "default_music_model": {
    "description": "默认音乐生成模型",
    "type": "string",
    "default": "music-2.6"
  },
  "default_music_cover_model": {
    "description": "默认音乐翻唱模型",
    "type": "string",
    "default": "music-cover-free"
  }
}
